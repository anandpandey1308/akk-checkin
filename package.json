{
  "name": "akk-checkin-system",
  "version": "1.0.0",
  "description": "Patient check-in, doctor queue, calling board, and file tracking for Asha Ki Kiran camps — multi-device backend",
  "main": "dist/main.js",
  "scripts": {
    "start": "node dist/main.js",
    "dev:backend": "tsx watch src/main.ts",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "concurrently --kill-others-on-fail \"npm:dev:backend\" \"npm:dev:frontend\"",
    "build:backend": "tsc",
    "build:frontend": "npm run build --prefix frontend",
    "build": "npm run build:backend && npm run build:frontend"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.8.0",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "multer": "^2.2.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@flydotio/dockerfile": "^0.7.10",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.1.1",
    "concurrently": "^10.0.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
